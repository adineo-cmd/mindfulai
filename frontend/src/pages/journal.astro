---
import BaseLayout from '../layouts/BaseLayout.astro';
import JournalIntegrations from '../components/journal/JournalIntegrations.tsx';
---

<BaseLayout title="Journal Integrations">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-8">
      <h1 class="page-title">Journal Integrations</h1>
      <p class="page-sub">Connect your favorite note-taking apps to sync your thoughts and track your emotional patterns.</p>
    </div>
    
    <JournalIntegrations client:load />
  </div>
</BaseLayout>