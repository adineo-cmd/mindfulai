---
import BaseLayout from '../layouts/BaseLayout.astro';
import PiCameraPanel from '../components/camera/PiCameraPanel.tsx';
---
<BaseLayout title="External Camera - Raspberry Pi">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-2">
        <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-green2 to-green3 flex items-center justify-center text-amber2 text-xl">
          📹
        </div>
        <div>
          <h1 class="page-title">External Camera</h1>
          <p class="page-sub">Raspberry Pi 3B+ with CSI Camera Module</p>
        </div>
      </div>
    </div>
    
    <PiCameraPanel client:load />
  </div>
</BaseLayout>